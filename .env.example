# Copy this file to .env and fill in your actual values.
# The app reads both plain GEMINI_API_KEY and project-prefixed HARNESS_GEMINI_API_KEY.
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional project-scoped aliases if you want to keep namespaced config:
# HARNESS_GEMINI_API_KEY=your_google_ai_studio_key_here
# HARNESS_GEMINI_MODEL=gemini-2.0-flash
